# Скопируйте в .env и при необходимости измените. Все значения ниже безопасны только для локального демо.
# Секреты в репозиторий не коммитятся (.env в .gitignore).

# --- Окружение ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
IMAGE_TAG=local                  # тег docker-образа приложения

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa           # СЕКРЕТ в проде
POSTGRES_DB=alfa
POSTGRES_PORT=5432               # порт на хосте

# --- Redis ---
REDIS_PORT=6379                  # порт на хосте

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin       # СЕКРЕТ в проде (access key)
MINIO_ROOT_PASSWORD=minioadmin   # СЕКРЕТ в проде (secret key)
MINIO_PORT=9000                  # S3 API на хосте
MINIO_CONSOLE_PORT=9001          # веб-консоль MinIO
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # хост в presigned URL, доступный браузеру

# --- API / сервисы ---
API_PORT=8000
ML_STUB_PORT=8100
JWT_SECRET=dev-only-jwt-secret-change-me-in-env-0123456789  # СЕКРЕТ (≥32 байт): подпись JWT пользователей и run-токенов
SERVICE_TOKEN=dev-only-service-token          # СЕКРЕТ: внутренние сервисные вызовы
ML_SERVICE_TOKEN=dev-only-ml-token            # СЕКРЕТ: бэкенд <-> ML-сервис

# --- Провайдеры ---
ML_SERVICE_URL=http://ml:8200                 # URL ML-сервиса (ml/); заглушка — http://ml-stub:8100
INTERNAL_API_URL=http://api:8000              # адрес бэкенда для агента (Tools API, LLM Gateway)
INSIGHT_GENERATOR=remote                      # remote (ML-сервис) | stub (ml-stub) | fake (тесты)
SCORER_PROVIDER=baseline                      # baseline (правила) | remote (/v1/score) | fake
EMBEDDING_PROVIDER=local                      # local (fastembed ONNX, выбор ML — ml/docs/DECISIONS.md ADR-ML-006) | fake (офлайн, тесты) | remote
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # 384 измерения = EMBEDDING_DIM
EMBEDDING_DIM=384                             # размерность vector(N); смена = миграция + переиндексация
EMBEDDING_REMOTE_URL=                         # OpenAI-совместимый URL сервиса эмбеддингов (remote)
EMBEDDING_REMOTE_KEY=                         # СЕКРЕТ: Bearer-токен сервиса эмбеддингов (если нужен)
OCR_PROVIDER=tesseract                        # tesseract | vlm (Qwen3-VL через Gateway) | fake
ANALYTICS_MAX_BYTES=50000000                  # максимальный размер одного PDF, байт
ANALYTICS_MAX_PAGES=150                       # максимальное число страниц PDF
ANALYTICS_MAX_RENDER_PIXELS=25000000          # предел пикселей на страницу OCR

# --- LLM Gateway (ключ выдают организаторы; без него всё работает на ml-stub) ---
LLM_BASE_URL=                                 # OpenAI-совместимый URL провайдера
LLM_API_KEY=                                  # СЕКРЕТ
LLM_PROVIDER=openai                           # openai (OpenAI-совместимый API) | fake (тесты/e2e, детерминированные ответы)
LLM_MODEL_MAP={}                              # JSON: алиас -> ID модели у провайдера, напр. {"qwen3.6-35b-a3b":"Qwen/Qwen3.6-35B-A3B"}
LLM_PRICES={}                                 # JSON: алиас -> [₽ за 1M входных, ₽ за 1M выходных токенов]; без цены — LLM_DEFAULT_PRICE_RUB_PER_1M
LLM_DEFAULT_PRICE_RUB_PER_1M=[100,300]        # консервативная цена для моделей без тарифа (бюджет считается с запасом)
LLM_DAILY_BUDGET_RUB=450                      # жёсткий дневной лимит (из 500 ₽ — запас); день — по Москве
LLM_DAILY_TOKEN_LIMIT=3000000                 # второй предохранитель: токены в сутки (вход + выход)
LLM_CACHE_TTL_H=168                           # кэш ответов на запросы с temperature=0

# --- Данные и пайплайны ---
DATA_DIR=data/synthetic                       # data/synthetic | data/raw (данные организаторов)
NEWS_FIXTURES_ENABLED=true                    # fixture-источник новостей (офлайн-демо, e2e); в проде false
NEWS_LIVE_SOURCES_ENABLED=true                # опрос реальных RSS из backend/data/reference/news_sources.json (e2e: false)
NEWS_POLL_INTERVAL_MIN=15                     # период опроса новостей планировщиком, мин
NOTIFICATIONS_POLL_S=2                        # SSE-уведомления: опрос новых раз в N с
NOTIFICATIONS_STREAM_MAX_S=300                # длительность соединения SSE; клиент переподключается с Last-Event-ID
DIGEST_DAILY_CRON=0 6 * * *                   # дайджест дня (UTC; 09:00 МСК)
DIGEST_WEEKLY_CRON=0 6 * * 1                  # дайджест недели (понедельник)
QA_TIMEOUT_S=90                               # предел ответа агента на вопрос
MATCH_SCOPE=users                             # users — кандидаты для компаний с пользователями | all — для всей клиентской базы
RATE_LIMIT_ENABLED=true                       # token bucket в Redis на вызывающего (токен или IP); Redis недоступен — пропускаем
RATE_LIMIT_PUBLIC_PER_MIN=120                 # /api/v1/*
RATE_LIMIT_INTERNAL_PER_MIN=1200              # /internal/* (агент)

# --- ML-сервис (ml/, команда ML) ---
ML_LLM_ENABLED=true                           # false — только rules@1 (без LLM)
ML_LLM_PLANNER=true                           # LLM-планировщик поверх правил (дешёвая модель)
ML_LLM_CRITIC=true                            # LLM-критик после детерминированной самопроверки
ML_MODEL_PLANNER=gemma-4-26b-a4b              # алиасы из GET /internal/llm/models
ML_MODEL_ANALYST=qwen3.6-35b-a3b
ML_MODEL_CRITIC=glm-5.3-flash
ML_MODEL_CHAT=qwen3.6-35b-a3b
ML_MAX_ITERATIONS=1                           # раунды исправления после критика (каждый ≈ +0,8 ₽)
ML_LLM_MIN_SCORE=0.5                          # LLM пишет только инсайты с релевантностью ≥ порога, остальное — rules@1
ML_PORT=8200
